# Copy to .env and fill in. Nothing here is a working secret.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Bootstrap superuser password; used only by the PostgreSQL bootstrap/role setup service.
POSTGRES_PASSWORD=
# Separate credentials for schema migrations and the runtime API. Use strong unique values.
LEDGER_MIGRATOR_PASSWORD=
LEDGER_APP_PASSWORD=

ENVIRONMENT=production
# Secure cookies are mandatory in production. For local plain-HTTP development only, set
# ENVIRONMENT=development and COOKIE_SECURE=false.
COOKIE_SECURE=true

INITIAL_ADMIN_EMAIL=admin@ledgercore.io
# Leave empty to have a random password generated and printed once in the API logs.
INITIAL_ADMIN_PASSWORD=
# Optional public demo login; startup creates this account with VIEWER (read-only) permissions.
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
SEED_DEMO_DATA=true
